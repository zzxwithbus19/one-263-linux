# PKGBUILD -- mc263 (Arch Linux)
#
# 分发路线：命令行构建，不走 AUR（不需要账号，也不需要审核）
#   bash packaging/build-arch.sh                 # 源码包 → sha256 → makepkg
#   bash packaging/build-arch.sh --repo          # 顺带 repo-add 建本地 pacman 仓库
#   sudo pacman -U dist/arch/mc263-26.3-2-x86_64.pkg.tar.zst
#
# 构建依赖自己装（脚本不联网、不替你 pacman -S）：
#   sudo pacman -S --needed base-devel qt6-base qt6-wayland python curl
#
# 本文件是模板：build-arch.sh 会把 pkgrel 与 tarball 的真实 sha256
# 填进 dist/arch/PKGBUILD 的副本，再交给 makepkg。

pkgname=mc263
pkgver=26.3
pkgrel=2
pkgdesc="Minecraft 26.3 launcher (Qt6 native, Wayland-ready)"
arch=('x86_64')
url="https://github.com/zzxwithbus19/one-263-linux"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-wayland' 'python' 'curl')
optdepends=('java-runtime: run the game (the launcher can also use Mojang runtimes)')
# 自建源分发只发主包，不生成 -debug（省得 release 里多一个没人下的包）
options=('!debug')
source=("mc263-$pkgver.tar.gz")
sha256sums=('SKIP')   # ← build-arch.sh 构建时替换成真实摘要

build() {
    cd "$pkgname-$pkgver"
    make
}

check() {
    cd "$pkgname-$pkgver"
    make check
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 build/mc263-qt "$pkgdir/usr/bin/mc263-qt"
    install -Dm644 packaging/mc263.desktop "$pkgdir/usr/share/applications/mc263.desktop"
    install -Dm644 packaging/mc263.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mc263.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 packaging/mc263.metainfo.xml "$pkgdir/usr/share/metainfo/mc263.metainfo.xml"
}
